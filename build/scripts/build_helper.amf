# -------------------------------------------------------------------------------
# Install the build and runtime dependencies of the OAI AMF: distribution
# packages plus the libraries that are built from source.
# Ubuntu 24.04 and the RHEL/Rocky 9 family are the supported distributions.
# -------------------------------------------------------------------------------

# -------------------------------------------------------------------------------
# Include the shared helper functions.
# -------------------------------------------------------------------------------

SCRIPT=$(readlink -f ${BASH_SOURCE})
THIS_SCRIPT_PATH=`dirname $SCRIPT`
COMMON_BUILD_PATH=$THIS_SCRIPT_PATH/../common-build/installation

source $COMMON_BUILD_PATH/build_helper
for helper in fmt spdlog pistache nlohmann nghttp2 yamlcpp cpr; do
  source $COMMON_BUILD_PATH/build_helper.$helper
done

# -------------------------------------------------------------------------------
# Install everything needed to build the AMF: the distribution packages, then
# the libraries that are built from source.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

check_install_amf_deps(){

  OPTION=""
  [ $1 -gt 0 ] && OPTION="-y"
  debug=0
  [ $2 -ne 0 ] && debug=1

  echo "Check supported distribution"
  check_supported_distribution || {
    echo_error "$(get_distribution_release) is not a supported distribution"
    return 1
  }

  # prevent lock on /var/lib/dpkg/lock
  if [[ $OS_DISTRO == "ubuntu" ]] && [ $IS_CONTAINER -eq 0 ]; then
    $SUDO sed -i 's/1/0/g' /etc/apt/apt.conf.d/10periodic
  fi

  update_package_db

  check_enable_epel_repos

  # Compilers, generators, ...
  PACKAGE_LIST="\
    autoconf \
    automake \
    $CMAKE \
    git"
  if [[ $OS_DISTRO == "ubuntu" ]]; then
    # build-essential pulls in gcc, g++ and make
    PACKAGE_LIST="$PACKAGE_LIST build-essential"
  elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST gcc-c++ make"
  else
    echo_fatal "$OS_DISTRO is not a supported distribution."
  fi
  echo "Install build tools"
  $SUDO $INSTALLER install $OPTION $PACKAGE_LIST || return $?

  # Libraries
  PACKAGE_LIST="\
    libtool \
    libxml2 \
    openssl \
    ninja-build \
    meson"
  if [[ $OS_DISTRO == "ubuntu" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST \
      libasio-dev \
      libboost-all-dev \
      libasan8 \
      mysql-client \
      libmysqlclient-dev \
      libcurl4-gnutls-dev \
      libevent-dev \
      libsctp-dev \
      libssl-dev \
      libxml2-dev \
      nettle-dev \
      libcurl4 \
      net-tools \
      pkg-config"
  elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
    PACKAGE_LIST="$PACKAGE_LIST \
      mysql \
      mysql-devel \
      mysql-libs \
      libgcrypt-devel \
      lksctp-tools \
      lksctp-tools-devel \
      openssl-devel \
      libxml2-devel \
      check \
      nettle-devel \
      libcurl-devel \
      pkgconfig \
      libasan"
  else
    echo_fatal "$OS_DISTRO is not a supported distribution."
  fi
  echo "Install distro libs"
  $SUDO $INSTALLER install $OPTION $PACKAGE_LIST || return $?
  echo "distro libs installation complete"

  for lib in fmt spdlog pistache nlohmann nghttp2 cpr libyaml_cpp; do
    install_${lib}_from_git $1 $2 || return $?
  done

  $SUDO ldconfig
  return 0

}

# -------------------------------------------------------------------------------
# Distribution detection.
# -------------------------------------------------------------------------------

OS_DISTRO=$(grep "^ID=" /etc/os-release | sed "s/ID=//" | sed "s/\"//g")
OS_RELEASE=$(grep "^VERSION_ID=" /etc/os-release | sed "s/VERSION_ID=//" | sed "s/\"//g")

# Echoes the distribution and its release joined, e.g. ubuntu24.04.
get_distribution_release() {
    if [[ ! -z "$OS_DISTRO$OS_RELEASE" ]]; then
        echo "$OS_DISTRO$OS_RELEASE"
    else
        echo Unknown
    fi
}

# Returns 1 where LTTNG is supported: build_amf adds -DUSE_LTTNG=ON on 1.
check_platform_for_lttng() {
  local distribution=$(get_distribution_release)
  if [[ "$distribution" == "ubuntu24.04" ]]; then
      return 1
  fi
  return 0
}
