#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface AMF service
#   Valid for Ubuntu-24.04 (noble)
#
# Builds on the common images from oai-cn5g-common-build:
#   oai-cn-base    build tools and the libraries built from source
#   oai-cn-runtime debug tools, shared runtime libraries and yq
#
#---------------------------------------------------------------------

ARG BASE_IMAGE=oai-cn-base:ubuntu
ARG RUNTIME_IMAGE=oai-cn-runtime:ubuntu

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------
FROM ${BASE_IMAGE} AS oai-amf-builder
ARG ENABLE_LTTNG=false

# Copying source code
COPY . /openair-amf
# Building AMF, then collecting the libraries it needs into runtime-libs
RUN /openair-amf/build/common-build/docker/build_nf.sh amf

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS oai-amf
ARG ENABLE_LTTNG=false

# Runtime packages only the AMF needs; the shared ones come from oai-cn-runtime
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
      libsctp1 \
      libsqlite3-0 \
# lttng
  && if [ "$ENABLE_LTTNG" = "true" ]; then DEBIAN_FRONTEND=noninteractive apt-get install --yes liblttng-ust-dev; fi \
  && rm -rf /var/lib/apt/lists/*

# Copying executable and generated libraries
WORKDIR /openair-amf/bin
COPY --from=oai-amf-builder \
    /openair-amf/build/amf/build/oai_amf \
    /openair-amf/scripts/healthcheck.sh \
    ./

# Copying only the libraries built from source, as collected in the builder
COPY --from=oai-amf-builder /openair-amf/runtime-libs/ /usr/local/lib/

RUN ldconfig && \
    ldd /openair-amf/bin/oai_amf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-amf/bin/oai_amf | grep "not found"

# Copying template configuration files
WORKDIR /openair-amf/etc
COPY --from=oai-amf-builder \
    /openair-amf/etc/config.yaml ./

WORKDIR /openair-amf

ARG GIT_COMMIT

LABEL org.opencontainers.image.authors="OpenAirInterface <oaicicdteam@openairinterface.org>" \
      org.opencontainers.image.vendor="OpenAirInterface Software Alliance" \
      org.opencontainers.image.licenses="Collaborative Standards Software License v1.0" \
      org.opencontainers.image.title="OAI AMF" \
      org.opencontainers.image.description="OpenAirInterface Access and Mobility Management Function" \
      org.opencontainers.image.revision="commit:${GIT_COMMIT}"

# expose ports
EXPOSE 80/tcp 9090/tcp 38412/sctp 5342 5343 5344
# healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-amf/bin/healthcheck.sh

CMD ["/openair-amf/bin/oai_amf", "-c", "/openair-amf/etc/config.yaml", "-o"]
