#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface AMF service
#   Valid for CentOS Stream 10
#
# Builds on the common images from oai-cn5g-common-build:
#   oai-cn-base    build tools and the libraries built from source
#   oai-cn-runtime debug tools, shared runtime libraries and yq
#
#---------------------------------------------------------------------

ARG BASE_IMAGE=oai-cn-base:centos
ARG RUNTIME_IMAGE=oai-cn-runtime:centos

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM ${BASE_IMAGE} AS oai-amf-builder

# Copy source code
COPY . /openair-amf

# Build AMF, then collect the libraries it needs into runtime-libs
RUN /openair-amf/build/common-build/docker/build_nf.sh amf

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM ${RUNTIME_IMAGE} AS oai-amf

# Runtime packages only the AMF needs; the shared ones come from oai-cn-runtime
RUN microdnf install -y \
      gmp \
      lksctp-tools && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-amf/bin
COPY --from=oai-amf-builder \
    /openair-amf/build/amf/build/oai_amf \
    /openair-amf/scripts/healthcheck.sh \
    ./

# Only the libraries built from source, as collected in the builder; /usr/lib64
# is on the default loader path, unlike /usr/local on EL
COPY --from=oai-amf-builder /openair-amf/runtime-libs/ /usr/lib64/

RUN ldconfig && \
    ldd /openair-amf/bin/oai_amf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-amf/bin/oai_amf | grep -q 'not found'

WORKDIR /openair-amf/etc
COPY --from=oai-amf-builder \
    /openair-amf/etc/config.yaml ./

WORKDIR /openair-amf

# Expose ports
EXPOSE 80/tcp 9090/tcp 38412/sctp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-amf/bin/healthcheck.sh

CMD ["/openair-amf/bin/oai_amf", "-c" , "/openair-amf/etc/config.yaml", "-o"]
